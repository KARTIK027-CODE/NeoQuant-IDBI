# IDBI Wealth Advisor — Backend Environment
# Copy this to .env and fill in your values before starting the server

# ── Required ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_48_CHAR_RANDOM_SECRET

# ── Optional — AI Integration ─────────────────────────────────
# Leave blank to use the built-in mock LLM (recommended for demo)
# Set to your OpenAI key to switch to live GPT-4o mini instantly
# OPENAI_API_KEY=sk-...

# ── Optional — Server Config ──────────────────────────────────
PORT=3001
# Restrict CORS to your frontend origin
ALLOWED_ORIGIN=http://localhost:5173
