# ─── NeoQuant ARIA — Environment Variables ───────────────────
#
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your keys below
#

# Backend API base URL
VITE_API_BASE=http://localhost:3001/api/v1

# ── D-ID API KEY (for real talking-face avatar like Citi Sky) ──
# Get FREE key at: https://studio.d-id.com → Sign Up → API Keys
# Free tier: 20 credits (~100 talking-face requests)
# Without this key: browser TTS + photo animation fallback
VITE_DID_API_KEY=

# ── OpenAI API KEY (for live LLM responses instead of mock) ───
# Get key at: https://platform.openai.com/api-keys
# Without this: smart mock responses are used
# Set in backend/.env, not here
